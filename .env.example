# LLM 配置（复制为 .env 后填写真实值）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_TIMEOUT=60

# Chat 顾问：一次用户请求的模型轮次与模型/工具总预算
CHAT_MAX_LLM_ROUNDS=100
CHAT_MAX_TOTAL_SECONDS=555
CHAT_DB_PATH=artifacts/chat/sessions.sqlite3
CHAT_MAX_CONCURRENT_TURNS=4

# 调试
DEBUG=false

# Chat Mode 只读 Python 沙箱（默认关闭）
SANDBOX_ENABLED=false
SANDBOX_BACKEND=auto
# Windows 使用准备产物 python.exe 的绝对路径，不能使用 venv redirector；见 sandbox-runtime/WINDOWS.md
SANDBOX_RUNTIME_PYTHON=
SANDBOX_MAX_CONCURRENCY=2
